# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://app:change-me@localhost:5432/ai_newspaper

# Admin authentication
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_ALLOWED_EMAILS=editor@example.com
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=

# Internal job authentication
INGESTION_API_TOKEN=replace-with-a-random-token

# AI enrichment
OPENAI_API_KEY=
OPENAI_MODEL=

# Source APIs
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=

# Object storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email provider
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=AI Newspaper <news@example.com>
EMAIL_REPLY_TO=editor@example.com

# Observability
ERROR_TRACKING_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
