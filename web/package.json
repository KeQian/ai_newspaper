{
  "name": "ai-newspaper-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "db:check": "drizzle-kit check",
    "contract:check": "tsx db/check-api-contract.ts",
    "config:check": "tsx db/check-config-template.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx db/run-seed.ts",
    "source:import": "tsx db/import-source-registry.ts",
    "source:run": "tsx db/run-source-connector.ts",
    "source:run-batch": "tsx db/run-connector-batch.ts",
    "candidate:process": "tsx db/process-candidates.ts",
    "candidate:prepare": "tsx db/prepare-candidates.ts",
    "automation:run": "tsx db/run-automation.ts",
    "newsletter:process": "tsx db/process-newsletter-email.ts",
    "ops:launch-check": "tsx db/check-launch-readiness.ts",
    "ops:restore-verify": "tsx db/verify-restored-database.ts",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm contract:check && pnpm config:check && pnpm db:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@neondatabase/serverless": "1.0.2",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "yaml": "2.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@cloudflare/workers-types": "5.20260911.1",
    "@electric-sql/pglite": "0.3.10",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.5",
    "esbuild": "0.27.0",
    "jsdom": "^30.0.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "^5.0.0",
    "wrangler": "4.130.0"
  },
  "type": "module"
}
